# ==============================================================================
# ContractRisk AI — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# ==============================================================================

# --- Local Generative LLM Settings (LM Studio) ---
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen3-4b-instruct-2507
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen3-4b-instruct-2507
LLM_TEMPERATURE=0.2

# --- Vector Store & Embedding Settings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5

# --- PostgreSQL Database Configuration ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contractrisk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password_here@localhost:5432/contractrisk
